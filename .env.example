# Copy to .env. Never commit .env. Empty values keep a door locked.

# Shown in the shell after `make project NAME=...`
WELLUX_AGENT_NAME=wellux
WELLUX_HOST_ID=wellux-shell
WELLUX_SHELL_PORT=8787

# Provider keys stay on the server. OrcaRouter is the recommended gateway.
# Base URL: https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# Supabase. The publishable key may ship to the browser. The service role may not.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal. Stay on sandbox until a capture has succeeded.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# OpenAI. Leave CHATGPT_CLIENT_ID empty until the first login returns an oaiapp_ id.
OPENAI_API_KEY=
CHATGPT_CLIENT_ID=

# Traces. Leave empty until a collector is running.
OTEL_EXPORTER_OTLP_ENDPOINT=
