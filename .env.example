# Copy to .env. Profiles: make personal | make business | make desktop

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google / Gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=

# xAI / Grok
XAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# OrcaRouter — OpenAI-compatible, base https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=

# OpenTelemetry (business profile). Leave unset to keep the exporter off.
OTEL_SERVICE_NAME=wellux
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_HEADERS=

# Optional
RUST_LOG=info

# --- Access. See docs/ACCESS.md. Leave unused doors empty. ---

# Supabase. The publishable key may ship to the browser. The service role may not.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal. Client id may ship to the button. Secret and webhook id may not.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ChatGPT sign-in stores its refresh token in the OS keychain, not in this file.
# CHATGPT_CLIENT_ID is the issued oaiapp_… id, never dynamic_agent_client.
CHATGPT_CLIENT_ID=
