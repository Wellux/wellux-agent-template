# Copy to .env. Profiles: make personal | make business | make desktop

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google / Gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=

# xAI / Grok
XAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# OrcaRouter — OpenAI-compatible, base https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=

# OpenTelemetry (business profile). Leave unset to keep the exporter off.
OTEL_SERVICE_NAME=wellux
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_HEADERS=

# Optional
RUST_LOG=info
